rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function ownsExistingDocument() {
      return isSignedIn() && resource.data.uid == request.auth.uid;
    }

    function validReaction(reactionId) {
      return request.resource.data.keys().hasOnly(['postId', 'userId', 'reactions', 'updatedAt'])
        && request.resource.data.keys().hasAll(['postId', 'userId', 'reactions', 'updatedAt'])
        && request.resource.data.postId is string
        && request.resource.data.postId.size() > 0
        && request.resource.data.userId == request.auth.uid
        && reactionId == request.resource.data.postId + '_' + request.auth.uid
        && exists(/databases/$(database)/documents/communityPosts/$(request.resource.data.postId))
        && (!('moderationStatus' in get(/databases/$(database)/documents/communityPosts/$(request.resource.data.postId)).data)
          || get(/databases/$(database)/documents/communityPosts/$(request.resource.data.postId)).data.moderationStatus != 'hidden')
        && request.resource.data.reactions is map
        && request.resource.data.reactions.keys().hasOnly(['useful', 'thanks'])
        && request.resource.data.reactions.keys().hasAll(['useful', 'thanks'])
        && request.resource.data.reactions.useful is bool
        && request.resource.data.reactions.thanks is bool
        && request.resource.data.updatedAt == request.time;
    }

    function validPushToken(deviceId) {
      return request.resource.data.keys().hasOnly([
          'token',
          'uid',
          'deviceId',
          'platform',
          'userAgent',
          'reminderTime',
          'notificationsEnabled',
          'lastActive',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'token',
          'uid',
          'deviceId',
          'platform',
          'userAgent',
          'reminderTime',
          'notificationsEnabled',
          'lastActive',
          'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.deviceId == deviceId
        && request.resource.data.token is string
        && request.resource.data.token.size() > 0
        && request.resource.data.token.size() <= 4096
        && request.resource.data.platform in ['web', 'android', 'ios']
        && request.resource.data.userAgent is string
        && request.resource.data.userAgent.size() <= 1024
        && request.resource.data.reminderTime is string
        && request.resource.data.reminderTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.notificationsEnabled is bool
        && request.resource.data.lastActive is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    match /pushTokens/{deviceId} {
      allow create: if isSignedIn() && validPushToken(deviceId);

      allow update: if ownsExistingDocument()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.deviceId == resource.data.deviceId
        && validPushToken(deviceId);

      allow read, delete: if ownsExistingDocument();
    }

    match /userActivity/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;

      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'unreadCommunityCount',
          'lastCommunitySeenAt'
        ])
        && request.resource.data.keys().hasAll([
          'unreadCommunityCount',
          'lastCommunitySeenAt'
        ])
        && request.resource.data.unreadCommunityCount is int
        && request.resource.data.unreadCommunityCount == 0
        && request.resource.data.lastCommunitySeenAt == request.time;

      allow update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'unreadCommunityCount',
          'lastCommunitySeenAt'
        ])
        && request.resource.data.keys().hasAll([
          'unreadCommunityCount',
          'lastCommunitySeenAt'
        ])
        && request.resource.data.unreadCommunityCount is int
        && request.resource.data.unreadCommunityCount == 0
        && request.resource.data.lastCommunitySeenAt == request.time;

      allow delete: if false;
    }

    match /communityPosts/{postId} {
      allow read: if true;

      allow create, update, delete: if false;
    }

    match /communityPostPrivate/{postId} {
      allow read, write: if false;
    }

    match /communityPrayerRequests/{requestId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /communityPrayerPrivate/{requestId} {
      allow read, write: if false;
    }

    match /communityPrayerCommitments/{commitmentId} {
      allow read, write: if false;
    }

    match /communityClock/{uid} {
      allow read, delete: if isSignedIn() && request.auth.uid == uid;

      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['requestedAt'])
        && request.resource.data.keys().hasAll(['requestedAt'])
        && request.resource.data.requestedAt == request.time;
    }

    match /communityReactions/{reactionId} {
      allow read: if true;

      allow create: if isSignedIn() && validReaction(reactionId);

      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.postId == resource.data.postId
        && validReaction(reactionId);

      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /communityReplies/{replyId} {
      allow read: if true;

      allow create, update, delete: if false;
    }

    match /communityReplyPrivate/{replyId} {
      allow read, write: if false;
    }

    match /communityReports/{reportId} {
      // Reports contain sensitive context; access only through authenticated callables.
      allow read, write: if false;
    }

    match /communityProfiles/{uid} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /communityNames/{normalizedName} {
      allow read, create, update, delete: if false;
    }

    match /userMetrics/{userId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /notifications/{notificationId} {
      function ownsNotification() {
        return isSignedIn() && resource != null
          && resource.data.keys().hasAll(['userId'])
          && request.auth.uid == resource.data.userId;
      }

      allow read: if ownsNotification();
      allow create: if false;
      allow update: if ownsNotification()
        && request.resource.data.keys().hasAll(['isRead'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
        && request.resource.data.isRead is bool;
      allow delete: if ownsNotification();
    }

    match /userProfiles/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
