{
  "type": "module",
  "scripts": {
    "android:copy": "rsync -av --delete --delete-excluded --prune-empty-dirs --exclude '.DS_Store' --exclude '*.log' --exclude '*.test.js' --exclude '/.git/***' --exclude '/node_modules/***' --exclude '/android/***' --exclude '/ios/***' --exclude '/www/***' --include '/.well-known/***' --include '/assets/***' --include '/compartir/***' --include '/css/***' --include '/data/' --include '/data/*.json' --include '/data/readings/***' --include '/hoy/***' --include '/icons/***' --include '/js/***' --include '/lectura/***' --include '/media/***' --include '/CNAME' --include '/.nojekyll' --include '/imagen modo oscuro.png' --include '/imagendefondo.png' --include '/index.html' --include '/manifest.json' --include '/privacy.html' --include '/sw.js' --exclude '*' ./ www/",
    "android:sync": "npm run android:copy && npx cap sync android",
    "android:open": "npm run android:sync && npx cap open android",
    "firebase:emulators": "firebase emulators:start --only functions,firestore",
    "firebase:deploy:functions": "firebase deploy --only functions",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules",
    "pwa:sync-version": "node scripts/sync-pwa-version.mjs",
    "community:migrate:last-activity": "npm --prefix functions run migrate:community:last-activity --",
    "test:community-rules": "firebase emulators:exec --only firestore --project demo-su-voz-rules \"node scripts/test-community-rules.mjs\"",
    "import:tla": "node scripts/import-tla-readings.mjs",
    "test:tla": "node scripts/validate-tla-readings.mjs",
    "test:bible-phase3": "node scripts/validate-bible-phase3.mjs",
    "test:bible-phase6": "node scripts/validate-bible-phase6.mjs",
    "test:bible-phase7": "node scripts/validate-bible-phase7.mjs",
    "test:bottom-nav": "node scripts/validate-bottom-nav.mjs",
    "test:analytics": "node scripts/validate-analytics-service.mjs"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.4.0",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/share": "^8.0.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@firebase/rules-unit-testing": "^5.0.2"
  }
}
